# ── Copy to .env and fill in your values ─────────────────────────────────────

# Telegram
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
ADMIN_IDS=123456789

# Binance (used only for public market data — no keys needed for scanning)
# Leave blank if you don't have a master key; each user provides their own
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false

# ── Strategy (mirrors PineScript inputs) ──────────────────────────────────────
ST_ATR_PERIOD=10
ST_MULTIPLIER=3.0
SL_BUFFER_ATR=0.7
TSL_BUFFER_ATR=0.5
TP_RR_RATIO=2.0
TP_MODE=RR
TP_PERCENT=1.0
DCA_METHOD=FVG
MTF_PIVOT_LEN=5

# ── Scanner ───────────────────────────────────────────────────────────────────
SCAN_INTERVAL_MINUTES=5
SCAN_TIMEFRAME=1h
SCAN_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,ADAUSDT,DOGEUSDT
MTF_CONFIRM_MIN_SCORE=3

# ── Trade monitor (checks open trades every N minutes) ───────────────────────
MONITOR_INTERVAL_MINUTES=1

# ── Trading defaults (per-user overrides via Settings menu) ──────────────────
DEFAULT_LEVERAGE=10
DEFAULT_MARGIN_TYPE=ISOLATED
DEFAULT_POSITION_SIZE=5.0
MAX_OPEN_TRADES=5
