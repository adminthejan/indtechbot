# ── Copy to .env and fill in your values ─────────────────────────────────────

# Telegram
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
ADMIN_IDS=123456789                  # comma-separated Telegram user IDs

# Binance (used only for public market data — no keys needed for scanning)
# Leave blank if you don't have a master key; each user provides their own
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false

# ── Strategy (mirrors PineScript inputs) ──────────────────────────────────────
ST_ATR_PERIOD=10
ST_MULTIPLIER=3.0
SL_BUFFER_ATR=0.7         # ATR multiplier for SL wick protection
TSL_BUFFER_ATR=0.5        # ATR multiplier for trailing SL buffer
TP_RR_RATIO=2.0           # Risk:Reward for take profit
TP_MODE=RR                # RR = risk/reward | PCT = percentage
TP_PERCENT=1.0            # Used only when TP_MODE=PCT
DCA_METHOD=FVG            # FVG | FIB618 | MID50
MTF_PIVOT_LEN=5

# ── Scanner ───────────────────────────────────────────────────────────────────
SCAN_INTERVAL_MINUTES=5
SCAN_TIMEFRAME=15m
SCAN_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,ADAUSDT,DOGEUSDT
MTF_CONFIRM_MIN_SCORE=3   # minimum MTF timeframes aligned (out of 5)

# ── Trade monitor (checks open trades every N minutes) ───────────────────────
MONITOR_INTERVAL_MINUTES=1

# ── Trading defaults (per-user overrides via Settings menu) ──────────────────
DEFAULT_LEVERAGE=10
DEFAULT_MARGIN_TYPE=ISOLATED
DEFAULT_POSITION_SIZE=5.0   # % of available USDT balance
MAX_OPEN_TRADES=5
